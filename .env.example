# Copiá este archivo como .env y ajustá lo que necesites.

PUERTO=3000
SECRETO_SESION=poné-acá-un-texto-largo-y-aleatorio

# Restringir el registro a correos institucionales (vacío = cualquier email)
# DOMINIO_EMAIL=fiuna.edu.py

# Verificación de notas para tutores:
#   insweb   -> inicia sesión de verdad en insweb.ing.una.py y lee Notas finales (por defecto)
#   simulado -> usa data/insweb-simulado.json (sin conexión, para ensayar)
VERIFICADOR=insweb

# Solo para VERIFICADOR=insweb (estos son los valores por defecto)
# INSWEB_URL=https://insweb.ing.una.py
# INSWEB_RUTA_LOGIN=/login
# INSWEB_RUTA_NOTAS_FINALES=/main/NotasFinales
# Endpoint del backend que devuelve las notas en JSON (descrip, codnota, ...):
# INSWEB_API_NOTAS=/insweb-backend/notas_finales
# INSWEB_TIMEOUT_MS=30000
# Textos del menú, usados solo si la ruta directa no funciona:
# INSWEB_MENU_NOTAS=Notas
# INSWEB_MENU_NOTAS_FINALES=Notas finales

MAX_MB_ARCHIVO=20

# Máximo de alumnos con tutoría activa por tutor
CUPO_TUTOR=5
